{
  "name": "weibook-icons",
  "version": "0.2.6",
  "scripts": {
    "ng": "ng",
    "icons:manifest": "node tools/generate-icons-manifest.mjs",
    "icons:cli": "node tools/cli.mjs",
    "icons:generate": "node tools/cli.mjs generate",
    "icons:validate": "node tools/cli.mjs validate",
    "icons:stats": "node tools/cli.mjs stats",
    "icons:optimize": "node tools/cli.mjs optimize",
    "build:core": "npm run --prefix projects/icon-core build",
    "react:manifest": "node tools/generate-react-manifest.mjs",
    "build:react": "npm run build:core && npm run react:manifest && npm run --prefix projects/icons-react build",
    "build:angular": "npm run icons:generate && ng build icons-angular",
    "build": "npm run icons:generate && ng build icons-angular && npm run build:react",
    "publish:core": "npm run --prefix projects/icon-core build && npm publish --access public --prefix projects/icon-core",
    "publish:react": "npm run build:react && npm publish --access public --prefix projects/icons-react",
    "publish:angular": "npm run build:angular && npm publish --access public --prefix dist/weibook-icons-angular",
    "publish:all": "npm run publish:core && npm run publish:react && npm run publish:angular",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:packages": "changeset publish",
    "release:ci": "npm run build && changeset publish && node tools/publish-angular-if-needed.mjs",
    "build:watch": "ng build icons-angular --watch --configuration development",
    "test": "ng test icons-angular",
    "lint": "ng lint icons-angular"
  },
  "private": true,
  "workspaces": [
    "projects/icon-core",
    "projects/icons-react"
  ],
  "dependencies": {
    "@angular/animations": "^14.2.0",
    "@angular/common": "^14.2.0",
    "@angular/compiler": "^14.2.0",
    "@angular/core": "^14.2.0",
    "@angular/forms": "^14.2.0",
    "@angular/platform-browser": "^14.2.0",
    "@angular/platform-browser-dynamic": "^14.2.0",
    "@angular/router": "^14.2.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~14.2.10",
    "@angular-eslint/builder": "^14.1.2",
    "@angular-eslint/eslint-plugin": "^14.1.2",
    "@angular-eslint/eslint-plugin-template": "^14.1.2",
    "@angular-eslint/template-parser": "^14.1.2",
    "@angular/cli": "~14.2.13",
    "@angular/compiler-cli": "^14.2.0",
    "@changesets/cli": "^2.29.7",
    "@types/jasmine": "~4.0.0",
    "@types/react": "^18.3.12",
    "@types/node": "^16.18.11",
    "@typescript-eslint/eslint-plugin": "^5.38.1",
    "@typescript-eslint/parser": "^5.38.1",
    "eslint": "^8.23.1",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "^14.2.0",
    "svgo": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "~4.7.2"
  }
}
